<Window x:Class="HwSuite.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VANTA" Width="1440" Height="900" MinWidth="1180" MinHeight="740"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Path Data="M0,0 L6,12 L12,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <TextBlock Text="VANTA" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" x:Name="NavPanel" Margin="0,10,0,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Tag="dashboard"/>
                    <RadioButton x:Name="NavFans" Style="{StaticResource NavItem}" GroupName="nav" Tag="fans"/>
                    <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" GroupName="nav" Tag="lighting"/>
                    <RadioButton x:Name="NavAl80" Style="{StaticResource NavItem}" GroupName="nav" Tag="al80"/>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="nav" Tag="system"/>
                </StackPanel>

                <!-- Fan control -->
                <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12,12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Fan control" Style="{StaticResource CardTitle}" FontSize="13.5" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="EngineSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="Fan control"
                                          ToolTip="On: VANTA drives the fans you chose. Off: every fan follows its BIOS or GPU firmware."/>
                        </Grid>
                        <TextBlock x:Name="EngineState" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Firmware controls every fan"/>
                        <Button x:Name="ReleaseButton" Content="Release all fans" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Margin="-10,4,0,0"
                                ToolTip="Hand every fan back to its firmware now and switch fan control off."/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MachineLine" Grid.Row="2" Style="{StaticResource Label}" VerticalAlignment="Bottom" Margin="8,0,0,10" Text="B660M DS3H"/>
            </Grid>
        </Border>

        <!-- Content column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="Dashboard" VerticalAlignment="Center"/>
                        <Border x:Name="FixtureBadge" Visibility="Collapsed" Margin="16,0,0,0" CornerRadius="11" Padding="10,3" VerticalAlignment="Center"
                                Background="{DynamicResource WarnSoftBrush}">
                            <TextBlock x:Name="FixtureText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" Text="Simulated fixture"/>
                        </Border>
                        <TextBlock x:Name="PageStatusText" Style="{StaticResource MonoMuted}" Margin="16,1,0,0" VerticalAlignment="Center" TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinButton" Style="{StaticResource CaptionBtn}" ToolTip="Minimize">
                            <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Margin="0,6,0,0"/>
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" ToolTip="Maximize">
                            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseBtn}" ToolTip="Close to tray">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" Margin="24,16,24,20"/>
        </Grid>
    </Grid>
</Window>
